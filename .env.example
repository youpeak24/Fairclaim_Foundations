# Contact form email settings (used by the Vercel serverless function in api/contact.ts).
# These are SECRETS and are only read on the server: never prefix them with VITE_.
#
# Locally: copy this file to .env and run `npx vercel dev`.
# On Vercel: add the same variables under Project Settings > Environment Variables, then redeploy.

# SMTP server of the mailbox that SENDS the email.
# Gmail:   smtp.gmail.com   (port 465, secure true) - use a Google "App Password", not your normal password.
# Outlook: smtp.office365.com (port 587, secure false)
# Zoho:    smtp.zoho.com    (port 465, secure true)
SMTP_HOST=
SMTP_PORT=465
# true for port 465, false for port 587 (STARTTLS). Optional: defaults to true only when the port is 465.
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Where enquiries are delivered (the owner's inbox). Defaults to SMTP_USER when left empty.
CONTACT_TO_EMAIL=

# Optional "From" address. Must be allowed by your SMTP provider; defaults to SMTP_USER.
CONTACT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Donations (see /donate and the hero widget)
# ---------------------------------------------------------------------------

# A) Secure checkout (Razorpay). SERVER-ONLY secrets: used by api/create-order.ts and api/verify-payment.ts.
# Get them at https://dashboard.razorpay.com > Account & Settings > API Keys. Use rzp_test_... keys while testing.
# In the dashboard, keep payment capture on "Automatic" so verified payments are not auto-refunded.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# B) Scan & pay (UPI QR) and WhatsApp screenshot. PUBLIC values (they are built into the site, so they are fine to expose).
# The QR shown to donors is public/brand/upi-qr.jpg. Its UPI ID and name are built in as defaults
# (src/data/donation.ts). Set these only to override them, and replace the image to match.
VITE_UPI_ID=
VITE_UPI_PAYEE_NAME=
# WhatsApp number that receives payment screenshots: digits only, with country code (India: 91XXXXXXXXXX).
VITE_WHATSAPP_NUMBER=
